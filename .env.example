SUPABASE_URL=
SUPABASE_SERVICE_KEY=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_ARK_MODEL=deepseek-v4-flash-ga-260731

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Origin of the deployed console (e.g. https://your-app.vercel.app), added
# to CORS allow_origins alongside http://localhost:3000. Only needed when
# the API is deployed somewhere the console reaches as a cross-origin
# request — unset locally, since local dev already matches the default.
FRONTEND_ORIGIN=

# Turn on the scheduler's fifth job, which creates synthetic Razorpay
# TEST payments and refunds on its own at irregular 20-90 minute
# intervals so the poller has something to discover during a demo.
# Off unless set to 1/true/yes. Every seeded payment runs through the
# whole pipeline and spends real LLM budget, so leave it unset outside
# of an active demo or recording session.
AUTO_SEED_ENABLED=0
