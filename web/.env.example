# Copy to web/.env.local. Next.js reads .env.local from this directory,
# not from the repository root — the root .env is the API's.
#
# Both Supabase values below are the PUBLIC ones (project URL and anon
# key). The service key belongs in the root .env and must never appear
# in a NEXT_PUBLIC_ variable, which is compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
